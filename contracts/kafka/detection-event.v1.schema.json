{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netguard.local/schemas/kafka/detection-event.v1.schema.json",
  "title": "NetGuard DetectionEvent v1",
  "description": "Detection candidate produced by analysis worker and consumed by backend classification/persistence (topic detections.created). Mirrors backend Detection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "method",
    "rule_id",
    "severity",
    "confidence",
    "src_ip",
    "dst_ip",
    "timestamp",
    "window_start",
    "duration_seconds",
    "features",
    "explanation"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "PORT_SCAN",
        "DOS_LIKE",
        "BRUTE_FORCE_LIKE",
        "ABNORMAL_CONNECTION_PATTERN"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "RULE",
        "STATISTICAL",
        "ML"
      ]
    },
    "rule_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "description": "Preliminary severity; backend is responsible for final classification."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "src_ip": {
      "type": "string",
      "oneOf": [
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ]
    },
    "dst_ip": {
      "type": "string",
      "oneOf": [
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Moment the detection was made."
    },
    "window_start": {
      "type": "string",
      "format": "date-time",
      "description": "Start of the analysed time window."
    },
    "duration_seconds": {
      "type": "integer",
      "enum": [
        1,
        10,
        60
      ],
      "description": "Length of the analysed time window."
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "description": "Measured numeric features only, never ground truth.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {
            "type": "number"
          }
        }
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
