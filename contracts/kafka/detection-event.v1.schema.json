{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netguard.local/schemas/kafka/detection-event.v1.schema.json",
  "title": "NetGuard DetectionEvent v1",
  "description": "Detection candidate produced by analysis worker and consumed by backend classification/persistence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "detection_id",
    "trace_id",
    "created_at",
    "type",
    "method",
    "confidence",
    "src_ip",
    "dst_ip",
    "window",
    "feature_values",
    "explanation",
    "related_flow_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "detection_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "enum": [
        "PORT_SCAN",
        "DOS_LIKE",
        "BRUTE_FORCE_LIKE",
        "ABNORMAL_CONNECTION_PATTERN"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "RULE",
        "STATISTICAL",
        "ML"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "description": "Optional preliminary severity; backend is responsible for final classification."
    },
    "src_ip": {
      "type": "string",
      "oneOf": [
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ]
    },
    "dst_ip": {
      "type": "string",
      "oneOf": [
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ]
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "duration_seconds"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "duration_seconds": {
          "type": "integer",
          "enum": [
            1,
            10,
            60
          ]
        }
      }
    },
    "feature_values": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number"
      },
      "description": "Measured numeric features only, never ground truth."
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "related_flow_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 1000
    },
    "rule_id": {
      "type": "string",
      "maxLength": 128
    },
    "model_version": {
      "type": "string",
      "maxLength": 128
    },
    "simulation_run_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    }
  }
}
