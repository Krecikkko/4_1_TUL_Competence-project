{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netguard.local/schemas/kafka/flow-event.v1.schema.json",
  "title": "NetGuard FlowEvent v1",
  "description": "Normalized, unidirectional laboratory network flow (topic flows.normalized). Mirrors backend NetworkFlow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "start_time",
    "duration_ms",
    "src_ip",
    "src_port",
    "dst_ip",
    "dst_port",
    "protocol",
    "packets",
    "bytes",
    "tcp_flags"
  ],
  "properties": {
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "src_ip": {
      "type": "string",
      "oneOf": [
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ]
    },
    "src_port": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 65535,
      "description": "null for protocols without ports (ICMP, ICMPV6, OTHER)."
    },
    "dst_ip": {
      "type": "string",
      "oneOf": [
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ]
    },
    "dst_port": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 65535,
      "description": "null for protocols without ports (ICMP, ICMPV6, OTHER)."
    },
    "protocol": {
      "type": "string",
      "enum": [
        "TCP",
        "UDP",
        "ICMP",
        "ICMPV6",
        "OTHER"
      ]
    },
    "packets": {
      "type": "integer",
      "minimum": 0
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "tcp_flags": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 255,
      "description": "TCP flags bit mask, null for non-TCP or unavailable."
    }
  }
}
