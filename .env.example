# Development-only host listener; Docker-to-Docker clients use kafka:9092.
KAFKA_HOST_PORT=9094

# PostgreSQL
POSTGRES_DB=netguard
POSTGRES_USER=netguard_user
POSTGRES_PASSWORD=change_this_password

# Django
DJANGO_SECRET_KEY=replace_with_a_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
